# =============================================================================
# Darasa / SomaAI Backend Environment Configuration
# =============================================================================

# --- Application Core ---
PROJECT_NAME="Darasa Educational Intelligence Backend"
ENVIRONMENT="development"               # development | staging | production
DEBUG=true
API_V1_PREFIX="/api/v1"

# --- Server & CORS ---
HOST="0.0.0.0"
PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://darasa.app"]

# --- PostgreSQL Database ---
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/darasa_db"
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis Cache & Session Store ---
# Format: redis://[[username]:[password]]@<host>:<port>/[db]
REDIS_URL="redis://localhost:6379/0"
REDIS_CACHE_EXPIRE_SECONDS=3600

# --- Security & JWT Authentication ---
# Generate using: openssl rand -hex 32
SECRET_KEY="PLACEHOLDER_JWT_SECRET_KEY_CHANGE_IN_PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440        # 24 hours

# =============================================================================
# External API Placeholders & Integrations
# =============================================================================

# --- AWS S3 Blueprint Ingestion Storage ---
AWS_ACCESS_KEY_ID="PLACEHOLDER_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="PLACEHOLDER_AWS_SECRET_ACCESS_KEY"
AWS_REGION="af-south-1"
S3_BUCKET_NAME="darasa-curriculum-blueprints-store"

# --- LLM Providers (OpenAI, Anthropic, Google Gemini) ---
OPENAI_API_KEY="PLACEHOLDER_OPENAI_API_KEY"
OPENAI_MODEL="gpt-4o"

ANTHROPIC_API_KEY="PLACEHOLDER_ANTHROPIC_API_KEY"
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

GOOGLE_GEMINI_API_KEY="PLACEHOLDER_GOOGLE_GEMINI_API_KEY"
GOOGLE_GEMINI_MODEL="gemini-1.5-pro"

# --- Embedding & Vector RAG (Kenya CBC Curriculum Vector Index) ---
EMBEDDING_API_KEY="PLACEHOLDER_EMBEDDING_API_KEY"
EMBEDDING_MODEL="text-embedding-3-small"
PINECONE_API_KEY="PLACEHOLDER_PINECONE_API_KEY"
PINECONE_INDEX_NAME="kicd-cbc-curriculum-index"

# --- Kenya NEMIS SSO & Student Verification Portal ---
NEMIS_BASE_URL="https://api.nemis.education.go.ke"
NEMIS_CLIENT_ID="PLACEHOLDER_NEMIS_CLIENT_ID"
NEMIS_CLIENT_SECRET="PLACEHOLDER_NEMIS_CLIENT_SECRET"
NEMIS_REDIRECT_URI="http://localhost:8000/api/v1/auth/nemis/callback"

# --- Kenya Payment Gateways (Safaricom M-Pesa Daraja API) ---
MPESA_ENVIRONMENT="sandbox"             # sandbox | production
MPESA_CONSUMER_KEY="PLACEHOLDER_MPESA_CONSUMER_KEY"
MPESA_CONSUMER_SECRET="PLACEHOLDER_MPESA_CONSUMER_SECRET"
MPESA_PASSKEY="PLACEHOLDER_MPESA_PASSKEY"
MPESA_SHORTCODE="174379"
MPESA_CALLBACK_URL="https://api.darasa.app/api/v1/payments/mpesa/callback"
